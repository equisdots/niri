// ============================================================================
// Environment - processes spawned by niri
// ============================================================================
// Translated from config/hypr/env.lua (the hl.env() calls).
//
// niri's `environment {}` has no variable expansion and only affects processes
// niri spawns (not the systemd user environment). Deliberately omitted:
//   - XDG_CURRENT_DESKTOP / XDG_SESSION_TYPE: set by the niri session
//     (niri-session), not by the config.
//   - GDK_BACKEND: a global `wayland` value breaks the screencast portal; niri
//     documents this explicitly. Do not re-add it here or in a shell rc.
//   - WALLPAPER_DIR / SCRIPT_DIR and the ~/.local/bin PATH injection: niri
//     cannot expand $HOME. Set these in ~/.zprofile / ~/.bash_profile instead;
//     niri-session imports the login-shell environment into systemd before
//     starting niri.
//   - HYPRLAND_LOG_WLR: Hyprland only.
//   - The appScale block at the end of env.lua: it is guarded by appScale != 1
//     and is tuned per install; add the derived variables in the login shell.
// ============================================================================

environment {
    // NVIDIA (kept for the author's NVIDIA rig; harmless on other GPUs).
    GBM_BACKEND "nvidia-drm"
    __GLX_VENDOR_LIBRARY_NAME "nvidia"
    LIBVA_DRIVER_NAME "nvidia"
    NVD_BACKEND "direct"

    // Qt. NOTE: niri recommends not forcing QT_QPA_PLATFORM globally unless a
    // specific app is broken; it is kept here to match env.lua, remove it if
    // the shell or an app misbehaves.
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_AUTO_SCREEN_SCALE_FACTOR "1"

    // SDL / Clutter.
    SDL_VIDEODRIVER "wayland"
    CLUTTER_BACKEND "wayland"

    // Electron / Chromium.
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    XOS_WL "1"

    // Cursor (mirrors the cursor {} block in config.kdl).
    XCURSOR_SIZE "24"
    XCURSOR_THEME "Bibata-Modern-Classic"

    // Java AWT/Swing under Wayland.
    _JAVA_AWT_WM_NONREPARENTING "1"

    // Mozilla (Firefox / Thunderbird).
    MOZ_ENABLE_WAYLAND "1"
    MOZ_DBUS_REMOTE "1"
}
