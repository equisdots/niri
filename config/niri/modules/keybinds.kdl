// ============================================================================
// Key bindings
// ============================================================================
// Translated from config/hypr/keybinds.lua.
//
// niri treats a duplicate key in `binds {}` as a parse error, while Hyprland
// silently allowed rebinding. The three conflicts found in the source config
// were resolved as: keep focus for Super+H/J/L, move lock to Super+Alt+L (see
// the README "known differences" section).
//
// Floating terminal/editor: Super+Shift+K and Super+Shift+D mirror Hyprland and
// call scripts/niri_floating_app.sh (spawn -> find via the niri event stream ->
// float -> set size -> center). The bar editor stays on Super+Shift+S.
//
// Panel toggles call the existing qs_manager.sh and reload.sh under
// ~/.config/hypr (strategy A). Numbered/page workspace routing calls
// scripts/niri_ws.sh so Quickshell popups close first. Wheel and
// focus-workspace-previous stay direct actions: niri_ws.sh has no interface
// for them, and spawning a process on every wheel tick would be worse than the
// direct action (the bind's cooldown-ms already debounces it).
// niri actions replace the Hyprland dispatchers.
// ============================================================================

binds {
    // ------------------------------------------------------------- applications
    Super+Return { spawn "kitty"; }
    Super+T      { spawn "kitty"; }
    Super+Shift+K { spawn-sh "bash ~/.config/niri/scripts/niri_floating_app.sh kitty 900 560 -- kitty"; }
    Super+Shift+D { spawn-sh "bash ~/.config/niri/scripts/niri_floating_app.sh code-insiders 1200 800 -- code-insiders -n"; }
    Super+E      { spawn "nautilus"; }
    Super+F      { spawn "firefox"; }
    Super+period { spawn-sh "rofi -show emoji -theme ~/.config/rofi/launcher.rasi"; }

    // ------------------------------------------------------------- Quickshell
    Super+Q { close-window; }
    Super+M { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle music"; }
    Super+C { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle clipboard"; }
    Super+D { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle applauncher"; }
    Super+B { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle battery"; }
    Super+W { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle wallpaper"; }
    Super+S { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle calendar"; }
    Super+N { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle network"; }
    Super+V { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle volume"; }
    Super+X { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle bar-editor guide"; }
    Super+Shift+S { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle bar-editor"; }
    // Plugins panel (manager + per-plugin settings pages), same as Hyprland.
    Super+Shift+M { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle plugins"; }
    Super+Shift+E { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle bar-editor bar"; }
    Super+Shift+T { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle focustime"; }
    Super+U { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle updater"; }
    Super+Y { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle quicknotes"; }
    Super+I { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle system-monitor"; }
    Super+O { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle rss-reader"; }
    Super+apostrophe { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle file-search"; }
    Super+Shift+B { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle window-controls"; }
    Super+Shift+P { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle palette"; }
    Super+Shift+X { spawn "kitty" "xturing"; }
    Super+Shift+W { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle widgets-redactor"; }
    Super+R { spawn-sh "bash ~/.config/hypr/scripts/reload.sh"; }
    Super+grave { toggle-overview; }

    // --------------------------------------------------------- window management
    Alt+F4 { close-window; }
    Super+Space { toggle-window-floating; }
    Super+G { center-window; }
    // Hyprland Super+Shift+Space was window.pin, which niri does not have. It
    // is repurposed to toggling the focused column's tabbed display.
    Super+Shift+Space { toggle-column-tabbed-display; }
    // Fullscreen / maximize. The niri defaults (Mod+F / Mod+Shift+F) collide
    // with the app binds above, so they live on Super+Shift+F / Super+Ctrl+M.
    // Super+Shift+M is the Plugins panel (same chord as Hyprland).
    Super+Shift+F { fullscreen-window; }
    Super+Ctrl+M  { maximize-column; }
    // niri's built-in hotkey help overlay.
    Super+Slash   { show-hotkey-overlay; }

    // ------------------------------------------------------ lock / logout / power
    // Lock moved from Hyprland's Super+L (which niri needs for focus-right).
    Super+Alt+L       { spawn-sh "bash ~/.config/hypr/scripts/lock.sh"; }
    // Hyprland's SUPER+SHIFT+Q exit; Super+Escape additionally skips the
    // confirmation so both leave the session immediately.
    Super+Shift+Q     { quit skip-confirmation=true; }
    Super+Escape      { quit skip-confirmation=true; }
    Super+Ctrl+S      { spawn "systemctl" "suspend"; }
    Super+Ctrl+Shift+L { spawn "systemctl" "poweroff"; }

    // ------------------------------------------------------------- screenshots
    // Open the equisdots Quickshell overlay (region + still/video + mic
    // selection), same UX as Hyprland. scripts/niri_screenshot.sh handles both
    // the overlay and the direct capture/record paths.
    Print            { spawn-sh "bash ~/.config/niri/scripts/niri_screenshot.sh"; }
    Shift+Print      { spawn-sh "bash ~/.config/niri/scripts/niri_screenshot.sh --edit"; }
    Super+Print      { spawn-sh "bash ~/.config/niri/scripts/niri_screenshot.sh --full"; }
    Super+Shift+Print { spawn-sh "bash ~/.config/niri/scripts/niri_screenshot.sh --full --edit"; }

    // ---------------------------------------------------------- screen recording
    // Same engine as Hyprland (gpu-screen-recorder), self-contained in
    // scripts/niri_record.sh. The bar's recording indicator reads the pid cache.
    Super+Alt+R       { spawn-sh "bash ~/.config/niri/scripts/niri_record.sh toggle"; }
    Super+Alt+Shift+R { spawn-sh "bash ~/.config/niri/scripts/niri_record.sh region"; }

    // ------------------------------------------------------------------ pickers
    // Hyprland used hyprpicker -a. niri has a native color pick; the wrapper
    // converts the 0.0..1.0 float channels to hex and copies them.
    Super+Shift+C { spawn-sh "bash ~/.config/niri/scripts/niri_pick_color.sh"; }

    // --------------------------------------------------------------- multimedia
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "bash ~/.config/hypr/scripts/volume.sh up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "bash ~/.config/hypr/scripts/volume.sh down"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "bash ~/.config/hypr/scripts/volume.sh mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "pactl set-source-mute @DEFAULT_SOURCE@ toggle"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "bash ~/.config/hypr/scripts/brightness.sh up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "bash ~/.config/hypr/scripts/brightness.sh down"; }
    Super+F3 { spawn-sh "bash ~/.config/hypr/scripts/brightness.sh up"; }
    Super+F2 { spawn-sh "bash ~/.config/hypr/scripts/brightness.sh down"; }

    XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioStop  allow-when-locked=true { spawn "playerctl" "stop"; }

    Super+equal     { spawn-sh "bash ~/.config/hypr/scripts/volume.sh up"; }
    Super+minus     { spawn-sh "bash ~/.config/hypr/scripts/volume.sh down"; }
    Super+BackSpace { spawn-sh "bash ~/.config/hypr/scripts/volume.sh mute"; }

    // ------------------------------------------------------------------- focus
    Super+Left  { focus-column-left; }
    Super+Right { focus-column-right; }
    Super+Up    { focus-window-up; }
    Super+Down  { focus-window-down; }
    Super+H     { focus-column-left; }
    Super+L     { focus-column-right; }
    Super+K     { focus-window-up; }
    Super+J     { focus-window-down; }
    Alt+Tab       { focus-window-previous; }
    Alt+Shift+Tab { focus-window-previous; }

    // ------------------------------------------------------------------ movement
    Super+Shift+Left  { move-column-left; }
    Super+Shift+Right { move-column-right; }
    Super+Shift+Up    { move-window-up; }
    Super+Shift+Down  { move-window-down; }
    Super+Shift+H { move-column-left; }
    Super+Shift+L { move-column-right; }
    Super+Shift+J { move-window-down; }

    // -------------------------------------------------------------------- resize
    Super+Ctrl+Left  { set-column-width "-5%"; }
    Super+Ctrl+Right { set-column-width "+5%"; }
    Super+Ctrl+Up    { set-window-height "-5%"; }
    Super+Ctrl+Down  { set-window-height "+5%"; }
    Super+Ctrl+H { set-column-width "-5%"; }
    Super+Ctrl+L { set-column-width "+5%"; }
    Super+Ctrl+K { set-window-height "-5%"; }
    Super+Ctrl+J { set-window-height "+5%"; }

    // ---------------------------------------------------------------- workspaces
    // Numbered focus/move goes through niri_ws.sh: it closes open Quickshell
    // popups first and keeps the shared Hyprland/niri routing behavior.
    Super+1 { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh 1"; }
    Super+2 { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh 2"; }
    Super+3 { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh 3"; }
    Super+4 { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh 4"; }
    Super+5 { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh 5"; }
    Super+6 { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh 6"; }
    Super+7 { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh 7"; }
    Super+8 { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh 8"; }
    Super+9 { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh 9"; }
    Super+0 { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh 10"; }

    Super+Shift+1 { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh 1 move"; }
    Super+Shift+2 { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh 2 move"; }
    Super+Shift+3 { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh 3 move"; }
    Super+Shift+4 { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh 4 move"; }
    Super+Shift+5 { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh 5 move"; }
    Super+Shift+6 { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh 6 move"; }
    Super+Shift+7 { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh 7 move"; }
    Super+Shift+8 { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh 8 move"; }
    Super+Shift+9 { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh 9 move"; }
    Super+Shift+0 { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh 10 move"; }

    Super+Page_Up   { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh prev"; }
    Super+Page_Down { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh next"; }
    // Direct: niri_ws.sh has no "previous" verb.
    Super+Tab       { focus-workspace-previous; }

    // Direct with cooldown: spawning a script per wheel tick would be worse
    // than the niri action; the popup-close nicety is not worth the churn.
    Super+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Super+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    // Scratchpad approximation (named workspace; no floating overlay). The
    // script focuses scratch, toggles back when it is already focused, and
    // launches nautilus when the workspace has no windows.
    Super+A       { spawn-sh "bash ~/.config/niri/scripts/niri_scratch.sh"; }
    Super+Shift+A { spawn-sh "bash ~/.config/niri/scripts/niri_ws.sh scratch move"; }

    // -------------------------------------------------------------- multi-monitor
    Super+Alt+I { focus-monitor-right; }
    Super+Alt+U { focus-monitor-left; }
    // Hyprland moves the active window, not the whole column.
    Super+Alt+Shift+I { move-window-to-monitor-right; }
    Super+Alt+Shift+U { move-window-to-monitor-left; }
    Super+Alt+P { move-workspace-to-monitor-next; }
    Super+Alt+M { spawn-sh "bash ~/.config/niri/scripts/niri_monitor_manager.sh"; }
    Super+Alt+Shift+M { spawn-sh "bash ~/.config/niri/scripts/niri_monitor_manager.sh info"; }

    // ------------------------------------------------------------ theme / scale
    Super+Z       { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle scale"; }
    Super+P       { spawn-sh "bash ~/.config/hypr/scripts/qs_manager.sh toggle idle"; }
    Super+Shift+Z { spawn-sh "bash ~/.config/niri/scripts/niri_scale.sh up"; }
    Super+Ctrl+Z  { spawn-sh "bash ~/.config/niri/scripts/niri_scale.sh down"; }

    // GPU performance mode (NVIDIA; shared script).
    Super+Alt+G       { spawn-sh "bash ~/.config/hypr/scripts/gpu-mode.sh cycle"; }
    Super+Alt+Shift+G { spawn-sh "bash ~/.config/hypr/scripts/gpu-mode.sh menu"; }

    // Force a niri config reload. Saving already live-reloads; the load-config
    // action makes the reload explicit for the reload key.
    Super+Shift+R { spawn-sh "niri msg action load-config-file --path $HOME/.config/niri/config.kdl"; }
}
